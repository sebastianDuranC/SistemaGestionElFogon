@page "{id:int}"
@model CapaPresentacion.Pages.Rol.EditModel
@using System.Text.Json

<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Editar Rol
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Modificar los datos del rol y sus permisos de acceso
            </p>
        </div>
        <a href="/Rol/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-primary px-4 py-2 text-sm font-medium text-white transition hover:bg-primary/90 hover:text-white/90">
            Volver
        </a>
    </div>

    <!-- Formulario -->
    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <form method="post" class="space-y-8 p-6">
            <input type="hidden" asp-for="RolEditado.Id" />
            <input type="hidden" asp-for="RolEditado.Estado" />

            <!-- Nombre del Rol -->
            <div class="max-w-md space-y-2">
                <label asp-for="RolEditado.Nombre" class="block text-sm font-medium text-zinc-700">
                    Nombre del Rol <span class="text-red-600">*</span>
                </label>
                <input asp-for="RolEditado.Nombre"
                       type="text" 
                       placeholder="Ej: Administrador, Vendedor, Cajero"
                       class="w-full rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-2.5 text-sm text-zinc-700 transition outline-none focus:border-red-500 focus:bg-white focus:ring-2 focus:ring-red-500/10"
                       required />
            </div>

            <!-- Listado de Permisos Agrupados por Modulo -->
            <div class="space-y-6 border-t border-zinc-100 pt-6">
                <div>
                    <h2 class="text-base font-semibold text-zinc-800">Asignación de Permisos</h2>
                    <p class="mt-1 text-sm text-zinc-500">Seleccione los accesos correspondientes para este rol.</p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    @foreach (var grupo in Model.PermisosPorModulo)
                    {
                        <div class="space-y-4 rounded-xl border border-zinc-200 bg-white p-5">
                            <div class="flex items-center justify-between border-b border-zinc-100 pb-2.5">
                                <h3 class="text-sm font-bold tracking-wide text-zinc-800 uppercase">
                                    @grupo.Key
                                </h3>
                                <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">
                                    @grupo.Value.Count permisos
                                </span>
                            </div>

                            <div class="space-y-2">
                                @foreach (var permiso in grupo.Value)
                                {
                                    bool isChecked = Model.SelectedPermisoIds.Contains(permiso.Id);
                                    <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-zinc-100 bg-zinc-50/50 p-3 transition hover:bg-zinc-100/70">
                                        <input type="checkbox" name="SelectedPermisoIds" value="@permiso.Id"
                                               @(isChecked ? "checked" : "")
                                               class="mt-1 h-4 w-4 rounded border-zinc-300 text-red-600 focus:ring-red-500" />
                                        <div class="space-y-0.5">
                                            <span class="block text-sm font-medium text-zinc-700">@permiso.FormNombre</span>
                                            <span class="block font-mono text-xs text-zinc-400">@permiso.FormRuta</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="flex flex-col gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
                <a href="/Rol/Index" class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-6 py-2.5 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
                    Cancelar
                </a>
                <button type="submit" id="btnGuardar" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-red-600 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-red-700">
                    Actualizar Rol
                </button>
            </div>
        </form>
    </div>
</section>