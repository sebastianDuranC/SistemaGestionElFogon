@page
@model CapaPresentacion.Pages.EgresoCaja.CreateModel
@{
    ViewData["Title"] = "Nuevo Egreso de Caja";
}

<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Nuevo Egreso de Caja
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Registrar un egreso o retiro de dinero en efectivo del cajón de la caja activa
            </p>
        </div>
        <a href="/ControlCaja/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
            Volver a Caja
        </a>
    </div>

    <!-- Formulario -->
    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm max-w-lg mx-auto">
        <form method="post" class="p-6 space-y-6">
            
            <div class="space-y-4">
                <!-- Motivo / Concepto -->
                <div class="space-y-2">
                    <label asp-for="NuevoEgreso.Motivo" class="block text-sm font-medium text-zinc-700">
                        Concepto / Motivo <span class="text-red-600">*</span>
                    </label>
                    <input asp-for="NuevoEgreso.Motivo"
                           type="text" 
                           placeholder="Ej. Pago a proveedor de carnes, pasaje mercado"
                           required
                           class="w-full rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-2.5 text-sm text-zinc-700 transition outline-none focus:border-red-500 focus:bg-white focus:ring-2 focus:ring-red-500/10 shadow-sm" />
                </div>

                <!-- Monto -->
                <div class="space-y-2">
                    <label asp-for="NuevoEgreso.Monto" class="block text-sm font-medium text-zinc-700">
                        Monto Retirado (Bs.) <span class="text-red-600">*</span>
                    </label>
                    <input asp-for="NuevoEgreso.Monto"
                           type="number" step="0.01" min="0.01"
                           placeholder="0.00"
                           required
                           class="w-full text-lg font-bold rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-2.5 text-zinc-850 transition outline-none focus:border-red-500 focus:bg-white focus:ring-2 focus:ring-red-500/10 shadow-sm" />
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="mt-8 flex flex-col gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
                <a href="/ControlCaja/Index" class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-6 py-2.5 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-red-600 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-red-700">
                    Registrar Egreso
                </button>
            </div>
        </form>
    </div>
</section>
