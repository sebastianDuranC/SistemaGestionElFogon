@page
@model CapaPresentacion.Pages.Venta.DetalleModel
<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Detalle de la venta #@Model.VentaCabecera.Id
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Registrada el @Model.VentaCabecera.Fecha.ToString("dd/MM/yyyy - HH:mm")
            </p>
        </div>
        <a href="/Venta/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver
        </a>
    </div>

    <!-- Tarjetas de Información -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <!-- Tarjeta Cliente -->
        <div class="flex items-start gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div class="space-y-1">
                <p class="font-semibold tracking-wider text-[10px] text-zinc-400 uppercase">Cliente</p>
                <p class="text-sm font-semibold text-zinc-800">@Model.VentaCabecera.Cliente</p>
                @if (Model.ClienteInfo != null && Model.ClienteInfo.EsComerciante)
                {
                    <span class="inline-block rounded-md border border-zinc-200 bg-zinc-100 px-2 py-0.5 font-semibold text-[10px] text-zinc-600">
                        Local: @Model.ClienteInfo.NumeroLocal | Pasillo: @Model.ClienteInfo.Pasillo
                    </span>
                }
            </div>
        </div>

        <!-- Tarjeta Tipo Pedido & Platos Prestados -->
        <div class="flex items-start gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            <div class="space-y-1.5">
                <p class="font-semibold tracking-wider text-[10px] text-zinc-400 uppercase">Entrega & Servicio</p>
                <div class="flex flex-wrap items-center gap-2">
                    @if (Model.VentaCabecera.EnLocal)
                    {
                        <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700 ring-1 ring-blue-700/10 ring-inset">En Local</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-semibold text-zinc-700 ring-1 ring-zinc-600/10 ring-inset">Para Llevar</span>
                    }

                    @if (Model.VentaCabecera.PlatoPrestado == true)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">
                            🍽️ Platos Pendientes
                        </span>
                    }
                    else if (Model.VentaCabecera.PlatoPrestado == false)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">
                            ✔️ Platos Devueltos
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Tarjeta Usuario Registrador -->
        <div class="flex items-start gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div>
                <p class="font-semibold tracking-wider text-[10px] text-zinc-400 uppercase">Vendedor</p>
                <p class="text-sm font-semibold text-zinc-800">@Model.VentaCabecera.Vendedor</p>
            </div>
        </div>
    </div>

    <!-- Layout Detalles y Finanzas -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <!-- Columna de Productos (2/3) -->
        <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm lg:col-span-2">
            <div class="border-b border-zinc-100 px-5 py-4">
                <h2 class="font-semibold text-[15px] text-zinc-800">Productos vendidos</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-zinc-50">
                        <tr class="border-b border-zinc-200 text-left text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                            <th class="px-5 py-3">Producto</th>
                            <th class="px-5 py-3 text-center">Cantidad</th>
                            <th class="px-5 py-3 text-right">Precio Unitario</th>
                            <th class="px-5 py-3 text-right">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100">
                        @if (Model.Detalles != null && Model.Detalles.Count > 0)
                        {
                            foreach (var item in Model.Detalles)
                            {
                                <tr class="transition hover:bg-zinc-50">
                                    <td class="px-5 py-3 font-medium text-zinc-900">@item.ProductoNombre</td>
                                    <td class="px-5 py-3 text-center text-zinc-600">@item.Cantidad</td>
                                    <td class="px-5 py-3 text-right text-zinc-600">Bs. @item.PrecioUnitario.ToString("N2")</td>
                                    <td class="px-5 py-3 text-right font-medium text-zinc-900">Bs. @item.SubTotal.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="px-5 py-8 text-center text-zinc-400">
                                    No se encontraron detalles para esta venta.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Columna de Pagos y Totales (1/3) -->
        <div class="flex flex-col gap-4">
            <!-- Métodos de Pago Aplicados -->
            <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
                <h3 class="border-zinc-150 mb-3 border-b pb-2 font-semibold text-[14px] text-zinc-800">Métodos de pago utilizados</h3>
                <div class="space-y-2">
                    @if (Model.Pagos != null && Model.Pagos.Count > 0)
                    {
                        foreach (var pago in Model.Pagos)
                        {
                            <div class="flex items-center justify-between border-b border-zinc-100 py-1.5 last:border-0">
                                <span class="text-xs font-semibold text-zinc-600">@pago.MetodoPagoNombre</span>
                                <span class="text-xs font-bold text-zinc-800">Bs. @pago.Monto.ToString("N2")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="py-2 text-xs text-zinc-400">No se encontraron pagos desglosados.</p>
                    }
                </div>
            </div>

            <!-- Resumen Financiero de la Venta -->
            <div class="space-y-3 overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-50 p-5 shadow-sm">
                <h3 class="border-b border-zinc-200 pb-2 font-semibold text-[14px] text-zinc-800">Resumen económico</h3>
                <div class="flex items-center justify-between text-xs">
                    <span class="font-medium text-zinc-500">Monto subtotal:</span>
                    <span class="font-semibold text-zinc-700">Bs. @Model.VentaCabecera.Total.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="font-medium text-zinc-500">Monto recibido:</span>
                    <span class="font-semibold text-zinc-700">Bs. @Model.VentaCabecera.MontoRecibido.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="font-medium text-zinc-500">Cambio devuelto:</span>
                    <span class="font-semibold text-emerald-600">Bs. @Model.VentaCabecera.CambioDevuelto.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between border-t border-zinc-200 pt-2 text-sm">
                    <span class="font-bold text-zinc-800">Total venta:</span>
                    <span class="text-base font-bold text-red-600">Bs. @Model.VentaCabecera.Total.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</section>
