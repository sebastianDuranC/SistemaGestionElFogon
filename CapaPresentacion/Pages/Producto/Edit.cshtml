@page "{id:int}"
@model CapaPresentacion.Pages.Producto.EditModel
<section class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-bold tracking-tight text-zinc-900">
                Editar Producto
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Modificar los datos del producto y su receta en el sistema
            </p>
        </div>
        <a href="/Producto/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
            Volver
        </a>
    </div>

    <!-- Formulario -->
    <form method="post" enctype="multipart/form-data" id="formProducto" class="space-y-6">
        <!-- Hidden inputs -->
        <input type="hidden" id="insumosJsonInput" asp-for="InsumosJson" />
        <input type="hidden" asp-for="ProductoEditado.Id" />
        <input type="hidden" asp-for="ProductoEditado.Estado" />

        <div class="grid gap-8 rounded-lg bg-white p-6 lg:grid-cols-2">
            <!-- COLUMNA IZQUIERDA: 1. Datos del Producto -->
            <div class="space-y-6">
                <h2 class="text-lg font-bold tracking-tight text-zinc-900">1. Datos del Producto</h2>
                
                <!-- Foto Card -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-zinc-700">
                        Foto del Producto (Dejar vacío para mantener la actual)
                    </label>
                    <div class="flex items-center gap-4">
                        @if (!string.IsNullOrEmpty(Model.ProductoEditado.FotoUrl))
                        {
                            <img src="@Model.ProductoEditado.FotoUrl" alt="Producto actual" class="h-16 w-16 rounded-xl border border-zinc-200 object-cover shadow-sm" />
                        }
                        <div class="relative flex min-h-[90px] flex-1 flex-col items-center justify-center rounded-xl border-2 border-dashed border-zinc-200 bg-white p-6 text-center transition hover:bg-zinc-50">
                            <span class="text-sm text-zinc-500">Selecciona una nueva imagen para cambiarla</span>
                            <input asp-for="Foto" type="file" accept="image/*" class="absolute inset-0 cursor-pointer opacity-0" />
                        </div>
                    </div>
                </div>

                <!-- Nombre -->
                <div class="space-y-2">
                    <label asp-for="ProductoEditado.Nombre" class="block text-sm font-medium text-zinc-700">
                        Nombre
                    </label>
                    <input asp-for="ProductoEditado.Nombre"
                           type="text" 
                           placeholder="Ej. Ala de pollo (1/4)"
                           required
                           class="w-full rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-sm text-zinc-800 shadow-sm transition outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/10" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <!-- Precio -->
                    <div class="space-y-2">
                        <label asp-for="ProductoEditado.Precio" class="block text-sm font-medium text-zinc-700">
                            Precio
                        </label>
                        <input asp-for="ProductoEditado.Precio"
                               type="number" step="0.01"
                               placeholder="0.00"
                               required
                               class="w-full rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-sm text-zinc-800 shadow-sm transition outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/10" />
                    </div>

                    <!-- Categoría -->
                    <div class="space-y-2">
                        <label asp-for="ProductoEditado.ProductoCategoriaId" class="block text-sm font-medium text-zinc-700">
                            Categoría
                        </label>
                        <select asp-for="ProductoEditado.ProductoCategoriaId"
                                required
                                class="w-full rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-sm text-zinc-700 shadow-sm transition outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/10">
                            <option value="">Seleccione</option>
                            @foreach (var cat in Model.ListaCategorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: 2. Receta / Insumos -->
            <div class="space-y-6">
                <h2 class="text-lg font-bold tracking-tight text-zinc-900">2. Receta / Insumos</h2>

                <!-- Agregar Insumo Card -->
                <div class="space-y-4 rounded-xl border border-zinc-200 bg-zinc-50 p-5 shadow-sm">
                    <!-- Seleccionar Insumo -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold tracking-wider text-zinc-500 uppercase">Seleccionar Insumo</label>
                        <select id="selectInsumo" class="w-full rounded-lg border border-zinc-200 bg-white px-3 py-2.5 text-sm text-zinc-700 shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/10">
                            <option value="">Seleccione</option>
                            @foreach (var ins in Model.ListaInsumos)
                            {
                                <option value="@ins.Id">@ins.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <!-- Cantidad -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold tracking-wider text-zinc-500 uppercase">Cantidad</label>
                            <input type="number" id="inputCantidad" step="0.01" min="0.01" placeholder="0.00" class="w-full rounded-lg border border-zinc-200 bg-white px-3 py-2.5 text-sm text-zinc-700 shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/10" />
                        </div>

                        <!-- Tipo -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold tracking-wider text-zinc-500 uppercase">Tipo</label>
                            <select id="selectTipo" class="w-full rounded-lg border border-zinc-200 bg-white px-3 py-2.5 text-sm text-zinc-700 shadow-sm outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/10">
                                <option value="Descartable">Descartable</option>
                                <option value="Comestible">Comestible</option>
                            </select>
                        </div>
                    </div>

                    <button type="button" onclick="agregarInsumoLista()" class="w-full cursor-pointer rounded-lg bg-red-600 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700">
                        Añadir Insumo a la Receta
                    </button>
                </div>

                <!-- Tabla de insumos agregados -->
                <div class="space-y-2">
                    <h3 class="mt-6 mb-2 text-sm font-semibold text-zinc-700">Insumos Agregados</h3>
                    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
                        <table class="w-full text-sm">
                            <thead class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                                <tr>
                                    <th class="px-4 py-3">INSUMO</th>
                                    <th class="px-4 py-3">CANTIDAD</th>
                                    <th class="px-4 py-3">TIPO</th>
                                    <th class="px-4 py-3 text-right">ACCIÓN</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyReceta" class="divide-y divide-zinc-100">
                                <tr id="trEmpty">
                                    <td colspan="4" class="px-4 py-6 text-center text-xs text-zinc-400">
                                        No se han agregado insumos a la receta de este producto.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones de acción -->
        <div class="mt-8 flex justify-end gap-3 border-zinc-200 pt-6">
            <button type="submit" id="btnGuardar" class="cursor-pointer rounded-lg bg-black px-6 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-zinc-800">
                Editar Producto
            </button>
        </div>
    </form>
</section>

@section Scripts {
<script>
    // Cargar receta inicial desde el PageModel y normalizar a PascalCase
    let rawInsumos = @Html.Raw(string.IsNullOrWhiteSpace(Model.InsumosJson) ? "[]" : Model.InsumosJson);
    let recetaInsumos = rawInsumos.map(item => ({
        InsumoId: item.InsumoId || item.insumoId,
        InsumoNombre: item.InsumoNombre || item.insumoNombre,
        Cantidad: item.Cantidad !== undefined ? parseFloat(item.Cantidad) : parseFloat(item.cantidad),
        Tipo: item.Tipo || item.tipo
    }));

    // Guardar insumos en el input oculto
    function actualizarInputJson() {
        document.getElementById('insumosJsonInput').value = JSON.stringify(recetaInsumos);
    }

    // Agregar un insumo a la lista
    function agregarInsumoLista() {
        const select = document.getElementById('selectInsumo');
        const insumoId = parseInt(select.value);
        const insumoNombre = select.options[select.selectedIndex].text;
        const cantidadInput = document.getElementById('inputCantidad');
        const cantidad = parseFloat(cantidadInput.value);
        const tipo = document.getElementById('selectTipo').value;

        if (!insumoId) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'Por favor, seleccione un insumo.' });
            return;
        }

        if (isNaN(cantidad) || cantidad <= 0) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'Por favor, ingrese una cantidad mayor a cero.' });
            return;
        }

        // Verificar si ya existe
        const existe = recetaInsumos.some(x => x.InsumoId === insumoId);
        if (existe) {
            Swal.fire({ icon: 'warning', title: 'Atención', text: 'Este insumo ya ha sido agregado a la receta.' });
            return;
        }

        // Agregar al array
        recetaInsumos.push({
            InsumoId: insumoId,
            InsumoNombre: insumoNombre,
            Cantidad: cantidad,
            Tipo: tipo
        });

        // Limpiar controles
        select.value = "";
        cantidadInput.value = "";

        // Re-renderizar tabla y actualizar json
        renderTable();
        actualizarInputJson();
    }

    // Eliminar insumo de la lista
    function eliminarInsumoLista(insumoId) {
        recetaInsumos = recetaInsumos.filter(x => x.InsumoId !== insumoId);
        renderTable();
        actualizarInputJson();
    }

    // Renderizar la tabla de insumos
    function renderTable() {
        const tbody = document.getElementById('tbodyReceta');
        tbody.innerHTML = '';

        if (recetaInsumos.length === 0) {
            tbody.innerHTML = `
                <tr id="trEmpty">
                    <td colspan="4" class="px-4 py-6 text-center text-xs text-zinc-400">
                        No se han agregado insumos a la receta de este producto.
                    </td>
                </tr>
            `;
            return;
        }

        recetaInsumos.forEach(item => {
            const row = document.createElement('tr');
            row.className = "hover:bg-zinc-50 border-b border-zinc-100 text-xs transition";
            row.innerHTML = `
                <td class="px-4 py-3 font-medium text-zinc-800">${item.InsumoNombre}</td>
                <td class="px-4 py-3 text-zinc-900">${item.Cantidad.toFixed(2)}</td>
                <td class="px-4 py-3">
                    <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ${item.Tipo === 'Comestible' ? 'bg-green-50 text-green-700' : 'bg-blue-50 text-blue-700'}">
                        ${item.Tipo}
                    </span>
                </td>
                <td class="px-4 py-3 text-right">
                    <button type="button" onclick="eliminarInsumoLista(${item.InsumoId})" class="cursor-pointer text-xs font-semibold text-red-500 hover:text-red-700">
                        Eliminar
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    // Al iniciar, renderizar la tabla con la receta existente
    document.addEventListener('DOMContentLoaded', () => {
        renderTable();
        actualizarInputJson();
    });
</script>
}
