@page
@model CapaPresentacion.Pages.Compra.DetalleModel
<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Detalle de Compra #@Model.CompraCabecera.Id
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Registrada el @Model.CompraCabecera.Fecha.ToString("dd/MM/yyyy - HH:mm")
            </p>
        </div>
        <a href="/Compra/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al Listado
        </a>
    </div>

    <!-- Tarjetas de Información -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <!-- Tarjeta Proveedor -->
        <div class="flex items-center gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-50 font-bold text-[14px] text-red-600">
                @(Model.CompraCabecera.NombreProveedor?.Length > 0 ? Model.CompraCabecera.NombreProveedor.Substring(0, 1).ToUpper() : "?")
            </div>
            <div>
                <p class="font-semibold tracking-wider text-[10px] text-zinc-400 uppercase">Proveedor</p>
                <p class="text-sm font-semibold text-zinc-800">@Model.CompraCabecera.NombreProveedor</p>
            </div>
        </div>

        <!-- Tarjeta Usuario -->
        <div class="flex items-center gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <div>
                <p class="font-semibold tracking-wider text-[10px] text-zinc-400 uppercase">Usuario Registrador</p>
                <p class="text-sm font-semibold text-zinc-800">@Model.CompraCabecera.NombreUsuario</p>
            </div>
        </div>
    </div>

    <!-- Detalles de la Compra -->
    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <div class="border-b border-zinc-100 px-5 py-4">
            <h2 class="font-semibold text-[15px] text-zinc-800">Insumos Adquiridos</h2>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-zinc-50">
                    <tr class="border-b border-zinc-200 text-left text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                        <th class="px-5 py-3">Insumo</th>
                        <th class="px-5 py-3 text-center">Cantidad</th>
                        <th class="px-5 py-3 text-right">Costo Unitario</th>
                        <th class="px-5 py-3 text-right">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                    @if (Model.Detalles != null && Model.Detalles.Count > 0)
                    {
                        foreach (var item in Model.Detalles)
                        {
                            <tr class="transition hover:bg-zinc-50">
                                <td class="px-5 py-3 font-medium text-zinc-900">@item.NombreInsumo</td>
                                <td class="px-5 py-3 text-center text-zinc-600">@item.Cantidad.ToString("G29")</td>
                                <td class="px-5 py-3 text-right text-zinc-600">Bs. @item.CostoUnitario.ToString("N2")</td>
                                <td class="px-5 py-3 text-right font-medium text-zinc-900">Bs. @item.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-5 py-8 text-center text-zinc-400">
                                No se encontraron detalles para esta compra.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Total de la Factura -->
        <div class="flex justify-end border-t border-zinc-100 bg-zinc-50 px-5 py-4">
            <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-zinc-500">Total Compra:</span>
                <span class="text-xl font-bold text-red-600">Bs. @Model.CompraCabecera.Total.ToString("N2")</span>
            </div>
        </div>
    </div>
</section>
