@page
@model CapaPresentacion.Pages.MetodoPago.CreateModel
@{
    ViewData["Title"] = "Nuevo Método de Pago";
}

<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Nuevo Método de Pago
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Ingresar un nuevo método de pago al sistema
            </p>
        </div>
        <a href="/MetodoPago/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
            Volver
        </a>
    </div>

    <!-- Formulario -->
    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <form method="post" class="p-6 space-y-6">
            
            <div class="grid gap-6 md:grid-cols-2">
                <!-- Nombre -->
                <div class="space-y-2">
                    <label asp-for="NuevoMetodoPago.Nombre" class="block text-sm font-medium text-zinc-700">
                        Nombre <span class="text-red-600">*</span>
                    </label>
                    <input asp-for="NuevoMetodoPago.Nombre"
                           type="text" 
                           placeholder="Ej. Efectivo, QR, Tarjeta"
                           required
                           class="w-full rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-2.5 text-sm text-zinc-700 transition outline-none focus:border-red-500 focus:bg-white focus:ring-2 focus:ring-red-500/10 shadow-sm" />
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="mt-8 flex flex-col gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
                <a href="/MetodoPago/Index" class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-6 py-2.5 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
                    Cancelar
                </a>
                <button type="submit" id="btnGuardar" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-red-600 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-red-700">
                    Guardar Método de Pago
                </button>
            </div>
        </form>
    </div>
</section>
