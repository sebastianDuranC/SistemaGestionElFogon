@page
@model CapaPresentacion.Pages.ControlCaja.IndexModel
@{
    ViewData["Title"] = "Control de Caja";
}

<section class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Control de Caja
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Apertura y cierre de turnos, arqueo de caja y egresos manuales del cajón
            </p>
        </div>
    </div>

    <!-- ESTADO DE CAJA ACTIVA -->
    @if (Model.CajaActiva == null)
    {
        <!-- Caja Cerrada -->
        <div class="rounded-2xl border border-zinc-200 bg-white p-8 text-center shadow-sm space-y-4">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-50 text-red-600">
                <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <div class="space-y-1">
                <h2 class="text-lg font-bold text-zinc-800">La Caja está Cerrada</h2>
                <p class="text-sm text-zinc-500 max-w-sm mx-auto">Debe realizar la apertura de la caja ingresando el monto inicial de efectivo en el cajón para comenzar a registrar ventas.</p>
            </div>
            <div>
                <a href="/ControlCaja/Apertura" class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-6 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-red-700 transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
                    </svg>
                    Apertura de Caja
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Caja Abierta -->
        <div class="grid gap-6 md:grid-cols-4">
            <!-- Card 1: Apertura -->
            <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm space-y-1">
                <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Monto Apertura</span>
                <div class="text-2xl font-bold text-zinc-800">Bs. @Model.ResumenCajaActiva.MontoApertura.ToString("0.00")</div>
                <div class="text-xs text-zinc-500">Saldo inicial ingresado</div>
            </div>

            <!-- Card 2: Ventas Efectivo -->
            <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm space-y-1">
                <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Ventas (Efectivo)</span>
                <div class="text-2xl font-bold text-green-600">Bs. +@Model.ResumenCajaActiva.VentasEfectivo.ToString("0.00")</div>
                <div class="text-xs text-zinc-500">Registrado en este turno</div>
            </div>

            <!-- Card 3: Egresos -->
            <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm space-y-1">
                <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Egresos del Turno</span>
                <div class="text-2xl font-bold text-red-600">Bs. -@Model.ResumenCajaActiva.TotalEgresos.ToString("0.00")</div>
                <div class="text-xs text-zinc-500">Salidas manuales de caja</div>
            </div>

            <!-- Card 4: Esperado -->
            <div class="rounded-xl border border-zinc-200 bg-zinc-900 text-white p-5 shadow-sm space-y-1">
                <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Monto Esperado</span>
                <div class="text-2xl font-bold">Bs. @Model.ResumenCajaActiva.MontoCierreEsperado.ToString("0.00")</div>
                <div class="text-xs text-zinc-300">Debería haber en cajón</div>
            </div>
        </div>

        <!-- Panel del Turno Activo -->
        <div class="rounded-2xl border border-zinc-200 bg-white shadow-sm overflow-hidden p-6 space-y-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-zinc-100 pb-4">
                <div>
                    <h2 class="text-base font-bold text-zinc-800 tracking-tight">Turno Activo</h2>
                    <p class="text-xs text-zinc-500 mt-0.5">Abierto por Cajero en fecha @Model.CajaActiva.FechaHoraApertura.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="flex gap-2">
                    <a href="/EgresoCaja/Create" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50 transition shadow-sm">
                        <svg class="h-4 w-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Registrar Egreso
                    </a>
                    <a href="/ControlCaja/Cierre" class="inline-flex items-center gap-1.5 rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 transition shadow-sm">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                        Cerrar Caja (Arqueo)
                    </a>
                </div>
            </div>

            <!-- Egresos del Turno -->
            <div class="space-y-3">
                <h3 class="text-sm font-bold text-zinc-700">Egresos Registrados en el Turno</h3>
                @if (Model.EgresosTurnoActivo.Count == 0)
                {
                    <p class="text-xs text-zinc-400 italic">No se han registrado retiros o egresos de efectivo en este turno.</p>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-zinc-100 bg-white">
                        <table class="w-full text-xs text-left">
                            <thead class="bg-zinc-50 border-b border-zinc-100 text-zinc-500 uppercase tracking-wider font-semibold">
                                <tr>
                                    <th class="px-4 py-2.5">Hora</th>
                                    <th class="px-4 py-2.5">Concepto / Motivo</th>
                                    <th class="px-4 py-2.5 text-right">Monto</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-50 text-zinc-700">
                                @foreach (var eg in Model.EgresosTurnoActivo)
                                {
                                    <tr>
                                        <td class="px-4 py-2.5">@eg.Fecha.ToString("HH:mm")</td>
                                        <td class="px-4 py-2.5 font-medium text-zinc-900">@eg.Motivo</td>
                                        <td class="px-4 py-2.5 text-right font-semibold text-red-600">-Bs. @eg.Monto.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- HISTORIAL DE TURNOS CERRADOS -->
    <div class="rounded-2xl border border-zinc-200 bg-white shadow-sm overflow-hidden p-6 space-y-4">
        <h2 class="text-base font-bold text-zinc-800 tracking-tight">Historial de Turnos Cerrados</h2>
        
        <div class="overflow-x-auto">
            <table id="table" class="w-full text-sm">
                <thead class="bg-zinc-50">
                    <tr class="border-b border-zinc-200 text-left text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                        <th class="px-5 py-3">Apertura</th>
                        <th class="px-5 py-3">Cierre</th>
                        <th class="px-5 py-3">Cajero</th>
                        <th class="px-5 py-3 text-right">Inicial</th>
                        <th class="px-5 py-3 text-right">Esperado</th>
                        <th class="px-5 py-3 text-right">Cierre Real</th>
                        <th class="px-5 py-3 text-right">Diferencia</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                    @foreach (var h in Model.HistoricoCajas)
                    {
                        <tr class="transition hover:bg-zinc-50">
                            <td class="px-5 py-3 text-xs text-zinc-600">
                                @h.FechaHoraApertura.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="px-5 py-3 text-xs text-zinc-600">
                                @h.FechaHoraCierre?.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="px-5 py-3 text-zinc-800 font-medium">
                                @h.NombreUsuario
                            </td>
                            <td class="px-5 py-3 text-right text-zinc-600">
                                Bs. @h.MontoApertura.ToString("0.00")
                            </td>
                            <td class="px-5 py-3 text-right text-zinc-600">
                                Bs. @h.MontoCierreEsperado?.ToString("0.00")
                            </td>
                            <td class="px-5 py-3 text-right text-zinc-950 font-semibold">
                                Bs. @h.MontoCierreReal?.ToString("0.00")
                            </td>
                            <td class="px-5 py-3 text-right font-bold @(h.Diferencial < 0 ? "text-red-600" : h.Diferencial > 0 ? "text-green-600" : "text-zinc-600")">
                                @(h.Diferencial > 0 ? "+" : "")Bs. @h.Diferencial?.ToString("0.00")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Paginación -->
        <div class="flex flex-col items-center justify-between gap-3 border-t border-zinc-100 px-5 py-4 md:flex-row" id="pagination-container">
            <div class="text-sm text-zinc-500" id="info"></div>
            <div class="flex items-center gap-2" id="pagination-buttons"></div>
        </div>
    </div>
</section>
