@page
@model CapaPresentacion.Pages.ControlCaja.AperturaModel
@{
    ViewData["Title"] = "Apertura de Caja";
}

<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Apertura de Caja
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Iniciar el turno registrando el saldo inicial de efectivo en el cajón
            </p>
        </div>
        <a href="/ControlCaja/Index" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
            Volver
        </a>
    </div>

    <!-- Formulario -->
    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm max-w-lg mx-auto">
        <form method="post" class="p-6 space-y-6">
            
            <div class="space-y-4">
                <div class="rounded-xl bg-zinc-50 p-4 border border-zinc-100 flex items-start gap-3">
                    <svg class="h-5 w-5 text-zinc-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-xs text-zinc-500 leading-relaxed">
                        El monto de apertura corresponde al dinero en efectivo que queda como "sencillo" o cambio en la caja registradora al iniciar el turno.
                    </p>
                </div>

                <!-- Monto Apertura -->
                <div class="space-y-2">
                    <label asp-for="NuevoTurno.MontoApertura" class="block text-sm font-medium text-zinc-700">
                        Monto de Apertura (Bs.) <span class="text-red-600">*</span>
                    </label>
                    <input asp-for="NuevoTurno.MontoApertura"
                           type="number" step="0.01" min="0"
                           placeholder="0.00"
                           required
                           class="w-full text-lg font-bold rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-zinc-800 transition outline-none focus:border-red-500 focus:bg-white focus:ring-2 focus:ring-red-500/10 shadow-sm" />
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="mt-8 flex flex-col gap-3 border-t border-zinc-100 pt-6 sm:flex-row sm:justify-end">
                <a href="/ControlCaja/Index" class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-200 bg-white px-6 py-2.5 text-sm font-medium text-zinc-600 transition hover:bg-zinc-50 hover:text-zinc-800">
                    Cancelar
                </a>
                <button type="submit" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-red-600 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-red-700">
                    Confirmar Apertura
                </button>
            </div>
        </form>
    </div>
</section>
