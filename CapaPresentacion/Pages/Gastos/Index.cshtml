@page
@model CapaPresentacion.Pages.Gastos.IndexModel
@{
    ViewData["Title"] = "Gastos Operativos";
}

<section class="space-y-5">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-800">
                Gastos Operativos
            </h1>
            <p class="mt-1 text-sm text-zinc-500">
                Administración de gastos generales y operativos del negocio
            </p>
        </div>
        <a href="/Gastos/Create" class="inline-flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-700">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nuevo Gasto Operativo
        </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <!-- Buscador -->
        <div class="flex flex-col gap-3 border-b border-zinc-100 px-5 py-4 md:flex-row md:items-center md:justify-between">
            <div class="relative w-full md:max-w-xs">
                <svg class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.85-5.15a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
                </svg>
                <input id="search" type="text" placeholder="Buscar gasto..."
                       class="w-full rounded-xl border border-zinc-200 bg-zinc-50 py-2 pr-4 pl-10 text-sm text-zinc-700 transition outline-none focus:border-red-500 focus:bg-white focus:ring-2 focus:ring-red-500/10" />
            </div>
        </div>

        <!-- Tabla -->
        <div class="overflow-x-auto">
            <table id="table" class="w-full text-sm">
                <thead class="bg-zinc-50">
                    <tr class="border-b border-zinc-200 text-left text-xs font-semibold tracking-wider text-zinc-500 uppercase">
                        <th class="px-5 py-3">Fecha</th>
                        <th class="px-5 py-3">Concepto</th>
                        <th class="px-5 py-3 text-right">Monto</th>
                        <th class="px-5 py-3">Registrado Por</th>
                        <th class="px-5 py-3 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                    @foreach (var item in Model.ListaGastos)
                    {
                        <tr class="transition hover:bg-zinc-50">
                            <td class="px-5 py-3 text-zinc-600">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="px-5 py-3 font-medium text-zinc-900">
                                @item.Concepto
                            </td>
                            <td class="px-5 py-3 text-red-600">
                                Bs. @item.Monto.ToString("0.00")
                            </td>
                            <td class="px-5 py-3 text-zinc-600">
                                @item.NombreUsuario
                            </td>
                            <td class="px-5 py-3 font-medium text-zinc-900">
                                <div class="flex justify-start gap-2">
                                    <a asp-page="/Gastos/Edit"
                                       asp-route-id="@item.Id"
                                       class="flex h-9 w-9 items-center justify-center rounded-lg border border-zinc-200 text-zinc-500 transition hover:border-yellow-200 hover:bg-yellow-100 hover:text-yellow-400"
                                       aria-label="Editar">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 2.651 2.651m-1.768-3.535a2.5 2.5 0 1 1 3.536 3.536L7.5 20.92 3 21l .08-4.5 13.781-13.781Z" />
                                        </svg>
                                    </a>
                                    <button type="button"
                                            onclick="confirmarEliminacion(@item.Id, 'El gasto operativo será eliminado')"
                                            class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-zinc-200 text-zinc-500 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12m-9 0V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-7 0v11a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V7M10 11v5m4-5v5" />
                                        </svg>
                                    </button>
                                    <form id="form-delete-@item.Id" method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:none;"></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Paginación -->
        <div class="flex flex-col items-center justify-between gap-3 border-t border-zinc-100 px-5 py-4 md:flex-row" id="pagination-container">
            <div class="text-sm text-zinc-500" id="info"></div>
            <div class="flex items-center gap-2" id="pagination-buttons"></div>
        </div>
    </div>
</section>
